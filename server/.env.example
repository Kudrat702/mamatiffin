# =================================
# SERVER ENVIRONMENT VARIABLES
# =================================

# Environment
NODE_ENV=development
APP_NAME=Tiffin Service API
APP_VERSION=1.0.0

# Server Configuration
PORT=3000
HOST=localhost
TRUST_PROXY=false

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/tiffin_service
DB_NAME=tiffin_service
DB_MAX_POOL_SIZE=10
DB_MIN_POOL_SIZE=1
DB_MAX_IDLE_TIME_MS=3000
DB_SERVER_SELECTION_TIMEOUT_MS=3000
DB_SOCKET_TIMEOUT_MS=45000

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12
SESSION_SECRET=your_super_secret_session_key_change_this_in_production

# CORS Configuration
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/gif
TEMP_UPLOAD_PATH=./temp

# Payment Gateway Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
PAYMENT_SUCCESS_URL=http://localhost:5173/payment/success
PAYMENT_CANCEL_URL=http://localhost:5173/payment/cancel

# SMS Configuration
SMS_API_KEY=your_sms_api_key_here
SMS_SENDER_ID=TIFFIN
SMS_TEMPLATE_ID=your_template_id_here
FAST_2_SMS_API_KEY=your_fast2sms_api_key_here

# Email Configuration
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password_or_app_password
EMAIL_FROM=Tiffin Service <noreply@tiffinservice.com>
EMAIL_REPLY_TO=support@tiffinservice.com

# Push Notification Configuration
FCM_SERVER_KEY=your_fcm_server_key_here
FCM_SENDER_ID=your_fcm_sender_id_here
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_EMAIL=mailto:your_email@domain.com

# Third-party APIs
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
WEATHER_API_KEY=your_weather_api_key_here

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
LOG_DATE_PATTERN=YYYY-MM-DD

# Cache Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password_here
CACHE_TTL=3600
ENABLE_REDIS_CACHE=false

# Security Headers
HELMET_CSP_ENABLED=true
HELMET_HSTS_ENABLED=true
HELMET_NO_SNIFF_ENABLED=true

# Monitoring & Analytics
ENABLE_MORGAN_LOGGING=true
ENABLE_COMPRESSION=true
ENABLE_HEALTH_CHECK=true
HEALTH_CHECK_PATH=/api/health

# Background Jobs
ENABLE_BACKGROUND_JOBS=true
JOB_CONCURRENCY=5
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_DELAY=3000

# Webhook Configuration
WEBHOOK_SECRET=your_webhook_secret_here
WEBHOOK_TIMEOUT=10000

# Development Configuration
DEBUG_MODE=false
ENABLE_SWAGGER=true
SWAGGER_PATH=/api/docs
ENABLE_PLAYGROUND=false

# Backup Configuration
BACKUP_PATH=./backups
AUTO_BACKUP_ENABLED=false
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30

# Notification Configuration
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_PUSH_NOTIFICATIONS=true
ADMIN_EMAIL=admin@tiffinservice.com
ADMIN_PHONE=+91XXXXXXXXXX

# Geolocation Configuration
DEFAULT_LATITUDE=28.6139
DEFAULT_LONGITUDE=77.2090
MAX_DELIVERY_RADIUS=25
LOCATION_API_PROVIDER=google

# Business Configuration
BUSINESS_NAME=Tiffin Service
BUSINESS_EMAIL=info@tiffinservice.com
BUSINESS_PHONE=+91XXXXXXXXXX
BUSINESS_ADDRESS=Your Business Address
BUSINESS_WEBSITE=https://tiffinservice.com

# Social Media
FACEBOOK_PAGE=https://facebook.com/yourpage
TWITTER_HANDLE=@yourhandle
INSTAGRAM_HANDLE=@yourhandle
LINKEDIN_PAGE=https://linkedin.com/company/yourcompany

# SEO Configuration
META_TITLE=Tiffin Service - Premium Food Delivery
META_DESCRIPTION=Get fresh, homemade meals delivered to your doorstep
META_KEYWORDS=tiffin,food delivery,homemade food,meal service
CANONICAL_URL=https://tiffinservice.com

# Error Tracking
SENTRY_DSN=your_sentry_dsn_here
ENABLE_ERROR_TRACKING=false

# Performance Monitoring
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key_here
ENABLE_PERFORMANCE_MONITORING=false