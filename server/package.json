{
  "name": "tiffin-service-backend",
  "version": "1.0.0",
  "description": "Tiffin Service Backend API - Production Ready",
  "main": "dist/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.x",
    "npm": ">=9.x"
  },
  "scripts": {
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "dev": "nodemon --exec ts-node server.ts",
    "dev:watch": "nodemon --watch '**/*.ts' --exec ts-node server.ts",
    "prebuild": "npm run clean",
    "build": "tsc && tsc-alias",
    "build:watch": "tsc --watch",
    "postbuild": "echo '✅ Build completed successfully for deployment'",
    "postinstall": "npm run build || echo '⚠️ Build skipped'",
    "predeploy": "npm run validate && npm run build",
    "deploy": "npm run predeploy && npm start",
    "validate": "npm run type-check && npm run lint",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "clean:all": "rimraf dist node_modules/.cache logs/*.log",
    "migration:fixIndexes": "ts-node scripts/migration.ts",
    "menu:transform": "ts-node scripts/menuDataTransform.ts",
    "migrate:menu": "ts-node scripts/menuDataTransform.ts",
    "db:seed": "ts-node scripts/seed.ts",
    "db:backup": "ts-node scripts/backup.ts",
    "logs:clear": "rimraf logs/*.log",
    "install:production": "npm install --omit=dev",
    "health-check": "node -e \"require('https').get(process.env.RAILWAY_PUBLIC_DOMAIN || 'http://localhost:3000' + '/api/health', res => process.exit(res.statusCode === 200 ? 0 : 1))\"",
    "railway:build": "npm install && npm run build",
    "railway:start": "NODE_ENV=production node dist/server.js"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.1",
    "fast-two-sms": "^1.0.4",
    "helmet": "^7.2.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.2",
    "morgan": "^1.10.1",
    "multer": "1.4.5-lts.2",
    "path-to-regexp": "^6.3.0",
    "razorpay": "^2.9.6",
    "rimraf": "^5.0.10",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5",
    "typescript": "^5.4.5",
    "tsc-alias": "^1.8.16",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/helmet": "^4.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.11.96",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.6.2",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.8",
    "@types/xlsx": "^0.0.36",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-security": "^3.0.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "tsconfig-paths": "^4.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/tiffin-service-backend.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/tiffin-service-backend/issues"
  },
  "homepage": "https://github.com/yourusername/tiffin-service-backend#readme",
  "keywords": [
    "tiffin",
    "food-delivery",
    "backend",
    "nodejs",
    "express",
    "mongodb",
    "typescript",
    "railway"
  ],
  "author": "Mohammad Kudratullah",
  "license": "ISC"
}