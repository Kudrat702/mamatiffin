{
  "name": "tiffin-service-backend",
  "version": "1.0.0",
  "description": "Tiffin Service Backend API - Production Ready",
  "main": "dist/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.x",
    "npm": ">=9.x"
  },
  "scripts": {
    "start": "node dist/server.js",
    "start:prod": "cross-env NODE_ENV=production node dist/server.js",
    "dev": "cross-env NODE_ENV=development nodemon --exec ts-node src/server.ts",
    "dev:watch": "cross-env NODE_ENV=development nodemon --watch src --exec ts-node src/server.ts",
    "build": "npm run clean && tsc && tsc-alias",
    "build:watch": "tsc --watch",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts || true",
    "lint:fix": "eslint . --ext .ts --fix || true",
    "test": "cross-env NODE_ENV=test jest || true",
    "test:watch": "cross-env NODE_ENV=test jest --watch || true",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage || true",
    "railway:build": "npm install && npm run build",
    "railway:start": "cross-env NODE_ENV=production node dist/server.js",
    "heroku-postbuild": "npm run build",
    "generate:hash": "node -e \"const bcrypt = require('bcrypt'); const pass = process.argv[1]; bcrypt.hash(pass, 12, (e, h) => console.log('Hash:', h));\"",
    "db:seed": "cross-env NODE_ENV=development ts-node src/scripts/seed.ts",
    "db:migrate": "cross-env NODE_ENV=development ts-node src/scripts/migrate.ts",
    "audit:fix": "npm audit fix",
    "audit:force": "npm audit fix --force",
    "update:deps": "npm update && npm audit fix"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.1",
    "fast-two-sms": "^1.0.4",
    "helmet": "^7.2.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.2",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.2",
    "multer-storage-cloudinary": "^4.0.0",
    "path-to-regexp": "^6.3.0",
    "razorpay": "^2.9.6",
    "rimraf": "^5.0.10",
    "streamifier": "^0.1.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.4.5",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/helmet": "^4.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.11.96",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.9.1",
    "@types/streamifier": "^0.1.2",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.8",
    "@types/xlsx": "^0.0.36",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "tsconfig-paths": "^4.2.0"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts,json",
    "ignore": [
      "src/**/*.spec.ts",
      "src/**/*.test.ts"
    ],
    "exec": "ts-node src/server.ts",
    "env": {
      "NODE_ENV": "development"
    }
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/**/*.test.ts",
      "!src/**/*.spec.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/tiffin-service-backend.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/tiffin-service-backend/issues"
  },
  "homepage": "https://github.com/yourusername/tiffin-service-backend#readme",
  "keywords": [
    "tiffin",
    "food-delivery",
    "backend",
    "nodejs",
    "express",
    "mongodb",
    "typescript",
    "railway",
    "mama-tiffin",
    "food-service",
    "api",
    "rest-api"
  ],
  "author": "Mohammad Kudratullah <mdkudratullah55@gmail.com>",
  "license": "ISC"
}