# =================================
# CLIENT ENVIRONMENT VARIABLES
# =================================

# API Configuration
VITE_API_URL=http://localhost:3000
VITE_API_TIMEOUT=10000

# App Configuration
VITE_APP_NAME=Tiffin Service
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Premium Tiffin Delivery Service

# Feature Flags
VITE_ENABLE_PWA=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_TRACKING=false
VITE_ENABLE_PERFORMANCE_MONITORING=false

# Third-party Services
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
VITE_GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
VITE_SENTRY_DSN=your_sentry_dsn_here

# Payment Gateway (Client-side keys)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Social Media
VITE_FACEBOOK_APP_ID=your_facebook_app_id_here
VITE_TWITTER_HANDLE=@yourtwitterhandle
VITE_INSTAGRAM_HANDLE=@yourinstagramhandle

# Contact Information
VITE_COMPANY_NAME=Tiffin Service
VITE_COMPANY_EMAIL=info@tiffinservice.com
VITE_COMPANY_PHONE=+91-XXXXXXXXXX
VITE_COMPANY_ADDRESS=Your Company Address

# Image Upload
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# Development Configuration
VITE_DEV_TOOLS=true
VITE_MOCK_API=false
VITE_DEBUG_MODE=false

# URL Configuration
VITE_CLIENT_URL=http://localhost:5173
VITE_BASE_URL=/

# PWA Configuration
VITE_PWA_NAME=Tiffin Service
VITE_PWA_SHORT_NAME=Tiffin
VITE_PWA_DESCRIPTION=Premium Tiffin Delivery Service
VITE_PWA_THEME_COLOR=#f97316
VITE_PWA_BACKGROUND_COLOR=#ffffff

# Notification Configuration
VITE_ENABLE_PUSH_NOTIFICATIONS=true
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# Map Configuration
VITE_DEFAULT_LAT=28.6139
VITE_DEFAULT_LNG=77.2090
VITE_DEFAULT_ZOOM=12

# Cache Configuration
VITE_CACHE_TTL=300000
VITE_ENABLE_SW_CACHE=true

# Security
VITE_ENABLE_CSP=true
VITE_TRUST_PROXY=false