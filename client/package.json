{
  "name": "tiffin-service-client",
  "private": true,
  "version": "1.0.0",
  "description": "Tiffin Service React Frontend with Vite",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite --mode development --port 5173 --host",
    "dev:admin": "vite --mode development.admin --port 3001 --host",
    "build": "vite build --mode production",
    "build:admin": "vite build --mode production.admin",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview --port 4173",
    "preview:admin": "vite preview --port 3002",
    "test": "echo 'Tests not configured yet' && exit 0",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist node_modules/.vite"
  },
  "dependencies": {
    "@emotion/babel-plugin": "11.13.5",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@types/react-helmet": "^6.1.11",
    "axios": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "11.18.2",
    "gsap": "3.13.0",
    "lucide-react": "0.451.0",
    "react": "18.3.1",
    "react-calendar": "5.1.0",
    "react-dom": "18.3.1",
    "react-helmet": "^6.1.0",
    "react-hook-form": "^7.65.0",
    "react-hot-toast": "2.6.0",
    "react-router-dom": "6.30.1"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@tailwindcss/vite": "4.1.15",
    "@types/node": "22.18.12",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "15.15.0",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.6.14",
    "tailwindcss": "4.1.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "5.4.21"
  }
}